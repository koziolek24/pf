cabal-version:      3.0
name:               yaml-parser
version:            0.1.0.0
synopsis:           Parse YAML into a universal AST
license:            MIT

common warnings
    ghc-options: -Wall -Wunused-imports

library
    import:           warnings
    exposed-modules:
        UniversalParser.AST
        UniversalParser.YamlParser
        UniversalParser.YamlPrinter
    build-depends:
        base       >= 4.14 && < 5,
        bytestring >= 0.10,
        containers >= 0.6,
        text       >= 1.2,
        HsYAML     >= 0.2
    hs-source-dirs:   src
    default-language: Haskell2010

executable yaml-parser
    import:           warnings
    main-is:          Main.hs
    build-depends:
        base       >= 4.6 && < 5,
        containers,
        text,
        yaml-parser
    hs-source-dirs:   app
    default-language: Haskell2010

test-suite yaml-parser-tests
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    build-depends:
        base       >= 4.14 && < 5,
        yaml-parser,
        hspec      >= 2.0,
        bytestring >= 0.10,
        containers >= 0.6,
        text       >= 1.2
    hs-source-dirs:   test
    default-language: Haskell2010
